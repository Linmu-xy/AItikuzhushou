<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!--
    日志方案：控制台 + 滚动文件。文件路径由 LOG_PATH 环境变量控制（Start-Tiku.ps1
    会设为项目根 logs/），默认 ./logs。业务日志与错误日志分离，保留 30 天。
  -->
  <springProperty scope="context" name="LOG_PATH" source="LOG_PATH" defaultValue="./logs" />
  <property name="FILE_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{requestId:-}] %logger{36} - %msg%n" />

  <!-- 控制台：dev 带简易时间；prod 同文件格式便于比对 -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <charset>UTF-8</charset>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] [%X{requestId:-}] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- 业务滚动文件 -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/tiku-api.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/tiku-api.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>50MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>5GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <charset>UTF-8</charset>
      <pattern>${FILE_PATTERN}</pattern>
    </encoder>
  </appender>

  <!-- 仅 WARN/ERROR，便于快速定位 -->
  <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/tiku-api-error.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/tiku-api-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>50MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>2GB</totalSizeCap>
    </rollingPolicy>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>WARN</level>
    </filter>
    <encoder>
      <charset>UTF-8</charset>
      <pattern>${FILE_PATTERN}</pattern>
    </encoder>
  </appender>

  <springProfile name="prod">
    <root level="INFO">
      <appender-ref ref="CONSOLE" />
      <appender-ref ref="FILE" />
      <appender-ref ref="ERROR_FILE" />
    </root>
  </springProfile>

  <springProfile name="!prod">
    <root level="INFO">
      <appender-ref ref="CONSOLE" />
    </root>
  </springProfile>

  <!-- 第三方噪音降级 -->
  <logger name="org.apache" level="WARN" />
  <logger name="org.hibernate" level="WARN" />
  <logger name="org.flywaydb" level="INFO" />
  <logger name="com.zaxxer.hikari" level="INFO" />
  <logger name="org.springframework.security" level="INFO" />
</configuration>
