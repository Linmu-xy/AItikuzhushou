DEEPSEEK_API_KEY=
DEEPSEEK_TEXT_MODEL=deepseek-flash
DEEPSEEK_QUESTION_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# 模型密钥加密主密钥（正式生产必须固定，≥16 字符，建议 64 位随机 hex）。
# 首次配置后不可更改：管理端保存的 DeepSeek Key 用它加密；更换或丢失会无法解密已托管密钥，
# 必须重新在管理端保存模型密钥才能恢复。启动脚本会强制校验其存在且长度足够。
APP_CONFIG_ENCRYPTION_KEY=replace-with-at-least-32-random-characters-fixed-once
APP_AI_STANDARD_EXTRACTION_ENABLED=true
APP_AI_QUESTION_REFINEMENT_ENABLED=true
APP_AI_QUESTION_BATCH_SIZE=3
# 独立职业审题：失败题只会带着审题反馈重试，不会进入题库或被“择优”绕过。
APP_AI_PROFESSIONAL_REVIEW_ENABLED=true
APP_AI_PROFESSIONAL_REVIEW_THRESHOLD=75
APP_AI_PROFESSIONAL_REVIEW_BATCH_SIZE=5
APP_AI_PROFESSIONAL_REVIEW_RETRY_ATTEMPTS=1
# 非从业者仅凭选项语气/常识猜对的概率上限，超过即只重写干扰项。
APP_AI_PROFESSIONAL_OUTSIDER_SOLVABLE_THRESHOLD=35
# 新环境可先设为 SHADOW 观察审计；确认后改为 ENFORCE 阻断低质量干扰项。
APP_AI_OPTION_REVIEW_MODE=ENFORCE
APP_AI_OPTION_REWRITE_MAX_ATTEMPTS=1
APP_AI_QUESTION_FULL_REWRITE_MAX_ATTEMPTS=1
APP_AI_QUESTION_PRO_ENABLED=true
APP_AI_QUESTION_PRO_BATCH_SIZE=3
APP_AI_QUESTION_PRO_CONTEXT_MAX_CHARS=4500
APP_AI_QUESTION_PRO_DESIGN_EFFORT=high
APP_AI_QUESTION_PRO_WRITE_EFFORT=low
APP_AI_QUESTION_PRO_OPTION_REWRITE_EFFORT=low
APP_DOCUMENT_QUEUE_KEY=tiku:document:jobs
APP_BUSINESS_QUEUE_KEY=tiku:business:jobs
APP_CAD_QUEUE_KEY=tiku:cad:jobs
APP_CAD_WORKER_COMMAND=python
APP_CAD_WORKER_SCRIPT=../tools/cad_worker/worker.py
APP_CAD_WORKER_PYTHONPATH=
APP_CAD_WORK_ROOT=./cad-work
APP_CAD_WORKER_TIMEOUT_SECONDS=300
APP_CAD_PREVIEW_DEFLECTION=0.5
APP_CAD_PREVIEW_MAX_TRIANGLES=250000
APP_CAD_DRAWING_DPI=300
APP_CAD_DRAWING_MAX_PAGES=40
APP_CAD_MAX_FILE_SIZE=67108864
APP_OCR_ENABLED=true
APP_OCR_MAX_PAGES=120
APP_OCR_TABLE_ENABLED=true
APP_OCR_TABLE_DPI=300
APP_FAST_DOCUMENT_ENABLED=false
APP_FAST_DOCUMENT_MAX_CHARACTERS=200000
APP_FAST_DOCUMENT_SEGMENT_CHARACTERS=1000
APP_FAST_DOCUMENT_MAX_QUESTIONS=2500
APP_FAST_DOCUMENT_MAX_SEGMENTS=400
APP_QUESTION_NORMALIZATION_ENABLED=false
APP_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
APP_BOOTSTRAP_ADMIN_PASSWORD=set-a-strong-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
POSTGRES_DB=tikuzhushou
POSTGRES_USER=tiku
POSTGRES_PASSWORD=change-me
JDBC_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/tikuzhushou
APP_STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
MINIO_BUCKET=tikuzhushou
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
APP_QUEUE_PROVIDER=redis
